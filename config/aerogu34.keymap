#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/naginata.dtsi>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/mouse-gesture.h>

#define FUNCTION_LAYER 1
#define NUMBER_LAYER 2
#define SCROLL_LAYER 3
#define NAGINATA_LAYER 4
#define MOUSE_LAYER 5
#define GESTURE_LAYER 6
#define SETTINGS_LAYER 7

// OS設定を日本語キーボードのまま使用するための変換定義。
// 共通レイアウトのNum層ではUS配列として扱いやすい標準keycodeを優先する。

#define JP_DQUOTE       AT
#define JP_AMPERSAND    CARET
#define JP_QUOTE        AMPERSAND
#define JP_EQUAL        UNDER
#define JP_CARET        EQUAL
#define JP_YEN          0x89
#define JP_PLUS         COLON
#define JP_TILDE        PLUS
#define JP_PIPE         LS(0x89)
#define JP_AT           LEFT_BRACKET
#define JP_COLON        SINGLE_QUOTE
#define JP_ASTERISK     DOUBLE_QUOTES
#define JP_BACKQUOTE    LEFT_BRACE
#define JP_UNDERSCORE   LS(0x87)
#define JP_LBRACKET     RIGHT_BRACKET
#define JP_RBRACKET     BACKSLASH
#define JP_LPAREN       ASTERISK
#define JP_RPAREN       LEFT_PARENTHESIS
#define JP_LBRACE       RIGHT_BRACE
#define JP_RBRACE       PIPE
#define JP_KANA         LANGUAGE_1
#define JP_EISU         LANGUAGE_2
#define JP_HANZEN       GRAVE

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};

&zip_mouse_gesture {
    enable-eager-mode;
    suppress-movement;
    stroke-size = <5>;
    movement-threshold = <6>;
    idle-timeout-ms = <100>;
    gesture-cooldown-ms = <160>;

    mission_control {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(UP_ARROW)>;
    };

    app_expose {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(DOWN_ARROW)>;
    };

    show_desktop {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp F11>;
    };

    next_space {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(RIGHT_ARROW)>;
    };
};

/ {
    macros {
        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_1 &kp INTERNATIONAL_4 &to NAGINATA_LAYER>;
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_2 &kp INTERNATIONAL_5 &to 0>;
        };

        gesture_mode: gesture_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo GESTURE_LAYER>,
                <&mouse_gesture>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mouse_gesture>,
                <&mo GESTURE_LAYER>;
        };

        // Utility layers sit below Naginata. While held, temporarily disable
        // Naginata, expose the requested utility layer, then restore Naginata.
        base_mo: base_mo {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &tog NAGINATA_LAYER>
                , <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                , <&macro_press &tog NAGINATA_LAYER>
                ;
        };

        base_lt: base_lt {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_press &tog NAGINATA_LAYER>
                , <&macro_param_1to1>
                , <&macro_param_2to2>
                , <&macro_press &lt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_param_2to2>
                , <&macro_release &lt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                , <&macro_press &tog NAGINATA_LAYER>
                ;
        };
    };

    behaviors {
        // Tap keeps Naginata's Space behavior; hold temporarily enters a
        // lower utility layer through base_mo.
        ng_lt: naginata_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            bindings = <&base_mo>, <&ng>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0>;
        };

        stab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <0 1 2 3 5>;
        };

        // Match Naginata's built-in V+M Enter chord on the Base layer.
        // Restrict to Base so the Naginata input processor handles its own V+M.
        base_enter_vm {
            bindings = <&kp ENTER>;
            key-positions = <23 26>; // V + M
            layers = <0>;
        };

        naginata_on {
            bindings = <&ng_on>;
            key-positions = <15 16>; // H + J
            layers = <0>;
        };

        naginata_off {
            bindings = <&ng_off>;
            key-positions = <13 14>; // F + G
            layers = <NAGINATA_LAYER>;
        };

        // Ignore the Naginata OFF combo when already in Base.
        // Without this, pressing F+G to turn Naginata off again types "fg".
        naginata_off_base_noop {
            bindings = <&none>;
            key-positions = <13 14>; // F + G
            layers = <0>;
        };

        gesture {
            timeout-ms = <50>;
            slow-release;
            bindings = <&gesture_mode>;
            key-positions = <0 1>; // Q + W
            layers = <0 NAGINATA_LAYER>;
        };

        // Hold . + / to enter Settings; release either key to return.
        // This replaces Q+P and avoids holding Settings' Q/P selection keys.
        settings {
            timeout-ms = <50>;
            slow-release;
            bindings = <&mo SETTINGS_LAYER>;
            key-positions = <28 29>; // . + /
            layers = <0 NAGINATA_LAYER MOUSE_LAYER>;
        };

        lwin {
            bindings = <&kp LEFT_WIN>;
            key-positions = <20 21>;
            layers = <0 1 2 3 5>;
        };

        lalt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <20 22>;
            layers = <0 1 2 3 5>;
        };

        ralt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <29 27>;
            layers = <0 1 2 3 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp Q                 &kp W              &kp E     &kp R  &kp T                                  &kp Y  &kp U  &kp I          &kp O  &lt SCROLL_LAYER P
&mt LCTRL A            &kp S              &kp D     &kp F  &kp G                                  &kp H  &kp J  &kp K          &kp L  &mt RCTRL SEMICOLON
&mt LEFT_SHIFT Z       &mt LEFT_ALT X     &mt LEFT_GUI C  &kp V  &kp B                            &kp N  &kp M  &mt RIGHT_GUI COMMA  &mt RIGHT_ALT DOT  &mt RIGHT_SHIFT SLASH
                                                &lt NUMBER_LAYER SPACE  &lt SCROLL_LAYER ESC    &kp BACKSPACE  &lt SCROLL_LAYER SPACE
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&kp F1         &kp F2           &kp F3      &kp F4         &kp F5                               &kp F6             &kp F7    &kp F8    &kp F9     &kp F10
&kp JP_COLON   &kp EXCLAMATION  &kp SLASH   &kp JP_LPAREN  &kp JP_LBRACKET                      &kp JP_UNDERSCORE  &mkp MB1  &kp UP    &mkp MB2   &kp F11
&kp SEMICOLON  &kp QUESTION     &kp JP_YEN  &kp JP_RPAREN  &kp JP_RBRACKET                      &kp JP_AT          &kp LEFT  &kp DOWN  &kp RIGHT  &kp F12
                                                            &trans           &trans    &trans     &trans
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
&kp N1          &kp N2         &kp N3        &kp N4         &kp N5                              &kp N6        &kp N7        &kp N8       &kp N9       &kp N0
&kp TAB         &kp GRAVE      &kp EQUAL     &kp COLON      &kp MINUS                           &kp LEFT      &kp DOWN      &kp UP       &kp RIGHT    &kp ENTER
&kp LEFT_SHIFT  &kp LEFT_ALT   &kp LEFT_GUI  &kp SEMICOLON  &kp LEFT_BRACKET                    &kp BACKSPACE &kp RIGHT_BRACKET  &kp COMMA  &kp DOT      &kp RIGHT_SHIFT
                                                        &trans          &trans      &trans       &trans
            >;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &mkp MB3   &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2   &kp UP    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp LEFT    &kp DOWN  &kp RIGHT
                                &trans  &trans    &trans  &trans
            >;
        };

        naginata_layer {
            display-name = "Naginata";
            bindings = <
&ng Q  &ng W  &ng E  &ng R  &ng T                    &ng Y  &ng U  &ng I      &ng O    &ng P
&ng A  &ng S  &ng D  &ng F  &ng G                    &ng H  &ng J  &ng K      &ng L    &ng SEMI
&ng Z  &ng X  &ng C  &ng V  &ng B                    &ng N  &ng M  &ng COMMA  &ng DOT  &ng SLASH
                &ng_lt NUMBER_LAYER SPACE  &base_lt SCROLL_LAYER ESC    &kp BACKSPACE  &ng SPACE
            >;
        };

        // Keep Auto Mouse above Naginata so I/J/K click bindings can override
        // Naginata while all transparent keys continue to fall through.
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &mkp MB3  &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
                                &trans  &trans    &trans  &trans
            >;
        };

        gesture_layer {
            display-name = "Gesture";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans  &trans
            >;
        };

        settings_layer {
            display-name = "Settings";
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4      &trans  &trans  &trans  &trans  &bt BT_CLR
&studio_unlock &trans         &trans         &trans         &trans               &trans  &trans  &trans  &trans  &trans
&sys_reset     &bootloader    &trans         &trans         &trans               &trans  &trans  &trans  &trans  &trans
                                              &trans  &trans  &trans  &trans
            >;
        };
    };
};
